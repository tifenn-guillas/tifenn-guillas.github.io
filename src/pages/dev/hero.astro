---
// TODO: supprimer cette page avant la release (Epic 6)
import BaseLayout from '../../layouts/BaseLayout.astro';
import { socials } from '../../data/socials';
---

<BaseLayout locale="fr" title="Dev — Hero mockups" description="Maquettes hero">

  <!-- Nav entre variantes -->
  <nav class="fixed top-0 inset-x-0 z-50 bg-tg-blue/90 flex justify-center gap-8 py-3 text-tg-white text-xs uppercase tracking-widest">
    <a href="#actuel" class="hover:text-tg-pink transition-colors">A — Actuel</a>
    <a href="#cta-socials" class="hover:text-tg-pink transition-colors">B — CTAs + Socials droite</a>
    <a href="#typewriter" class="hover:text-tg-pink transition-colors">C — Typewriter + CTAs + Socials droite</a>
  </nav>

  <!-- ─── VARIANTE A — Actuel ─────────────────────────────────────────── -->
  <section id="actuel" class="relative h-screen bg-header-image bg-cover bg-center bg-fixed">
    <div class="absolute top-2 left-1/2 -translate-x-1/2 bg-tg-pink text-tg-white text-xs px-3 py-1 uppercase tracking-wider z-10">
      A — Actuel (référence)
    </div>
    <div class="h-screen bg-tg-blue/30">
      <div class="absolute top-1/3 inset-x-0">
        <h1 class="pb-8 text-7xl text-tg-white text-center">Tifenn Guillas</h1>
        <div class="text-center">
          <span class="inline-block bg-tg-pink text-tg-white uppercase m-2.5 p-2.5 tracking-widest">
            Développeuse d'Applications Web
          </span>
        </div>
      </div>
      <div class="absolute bottom-0 inset-x-0 text-center animate-bounce">
        <a class="text-tg-white p-10 pb-0" href="#cta-socials">
          <i class="fa fa-3x fa-angle-down"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── VARIANTE B — CTAs + Socials droite ───────────────────────── -->
  <section id="cta-socials" class="relative h-screen bg-header-image bg-cover bg-center bg-fixed">
    <div class="absolute top-2 left-1/2 -translate-x-1/2 bg-tg-pink text-tg-white text-xs px-3 py-1 uppercase tracking-wider z-10">
      B — CTAs + Socials (droite)
    </div>
    <div class="h-screen bg-tg-blue/30">
      <!-- Contenu centré + socials dans le même bloc -->
      <div class="absolute top-1/3 inset-x-0 -translate-y-4">
        <div class="relative">
          <h1 class="pb-6 text-7xl text-tg-white text-center">Tifenn Guillas</h1>
          <div class="text-center">
            <span class="inline-block bg-tg-pink text-tg-white uppercase m-2.5 p-2.5 tracking-widest">
              Développeuse d'Applications Web
            </span>
          </div>
          <!-- CTAs -->
          <div class="mt-10 flex justify-center gap-6">
            <a href="#portfolio"
               class="border-2 border-tg-white text-tg-white uppercase px-6 py-3 tracking-widest text-sm hover:bg-tg-white hover:text-tg-blue transition-colors">
              Portfolio
            </a>
            <a href="#contact"
               class="border-2 border-tg-white text-tg-white uppercase px-6 py-3 tracking-widest text-sm hover:bg-tg-white hover:text-tg-blue transition-colors">
              Contact
            </a>
          </div>
          <!-- Socials alignés à droite du bloc contenu -->
          <div class="absolute right-8 inset-y-0 flex flex-col justify-center gap-5">
            {socials.map((s) => (
              <a href={s.url} target={s.external === false ? '_self' : '_blank'} title={s.name}
                 class="text-tg-white hover:text-tg-pink transition-colors text-xl">
                <span class={s.fontawesome}></span>
              </a>
            ))}
          </div>
        </div>
      </div>
      <!-- Flèche bas -->
      <div class="absolute bottom-0 inset-x-0 text-center animate-bounce">
        <a class="text-tg-white p-10 pb-0" href="#typewriter">
          <i class="fa fa-3x fa-angle-down"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── VARIANTE C — Typewriter + CTAs + Socials droite ───────────── -->
  <section id="typewriter" class="relative h-screen bg-header-image bg-cover bg-center bg-fixed">
    <div class="absolute top-2 left-1/2 -translate-x-1/2 bg-tg-pink text-tg-white text-xs px-3 py-1 uppercase tracking-wider z-10">
      C — Typewriter + CTAs + Socials (droite)
    </div>
    <div class="h-screen bg-tg-blue/30">
      <div class="absolute top-1/3 inset-x-0 -translate-y-4">
        <div class="relative">
          <h1 class="pb-6 text-7xl text-tg-white text-center">Tifenn Guillas</h1>
          <div class="text-center min-h-12">
            <span class="inline-block bg-tg-pink text-tg-white uppercase m-2.5 p-2.5 tracking-widest">
              <span id="typewriter-text"></span><span class="typewriter-cursor">|</span>
            </span>
          </div>
          <!-- CTAs -->
          <div class="mt-10 flex justify-center gap-6">
            <a href="#portfolio"
               class="border-2 border-tg-white text-tg-white uppercase px-6 py-3 tracking-widest text-sm hover:bg-tg-white hover:text-tg-blue transition-colors">
              Portfolio
            </a>
            <a href="#contact"
               class="border-2 border-tg-white text-tg-white uppercase px-6 py-3 tracking-widest text-sm hover:bg-tg-white hover:text-tg-blue transition-colors">
              Contact
            </a>
          </div>
          <!-- Socials alignés à droite du bloc contenu -->
          <div class="absolute right-8 inset-y-0 flex flex-col justify-center gap-5">
            {socials.map((s) => (
              <a href={s.url} target={s.external === false ? '_self' : '_blank'} title={s.name}
                 class="text-tg-white hover:text-tg-pink transition-colors text-xl">
                <span class={s.fontawesome}></span>
              </a>
            ))}
          </div>
        </div>
      </div>
      <!-- Flèche bas -->
      <div class="absolute bottom-0 inset-x-0 text-center animate-bounce">
        <a class="text-tg-white p-10 pb-0" href="#actuel">
          <i class="fa fa-3x fa-angle-down"></i>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .typewriter-cursor {
    animation: blink 0.7s step-end infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>

<script is:inline>
  const phrases = [
    "Développeuse d'Applications Web",
    "Angular & TypeScript",
    "Symfony & PHP",
    "Fan de Docker & CI/CD",
  ];
  let phraseIndex = 0;
  let charIndex = 0;
  let deleting = false;
  const el = document.getElementById('typewriter-text');

  function tick() {
    if (!el) return;
    const current = phrases[phraseIndex];
    if (deleting) {
      charIndex--;
      el.textContent = current.slice(0, charIndex);
      if (charIndex === 0) {
        deleting = false;
        phraseIndex = (phraseIndex + 1) % phrases.length;
        setTimeout(tick, 400);
        return;
      }
      setTimeout(tick, 40);
    } else {
      charIndex++;
      el.textContent = current.slice(0, charIndex);
      if (charIndex === current.length) {
        deleting = true;
        setTimeout(tick, 2000);
        return;
      }
      setTimeout(tick, 80);
    }
  }

  // Démarre quand la variante C est visible
  const observer = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting && el && el.textContent === '') tick();
  }, { threshold: 0.5 });
  const section = document.getElementById('typewriter');
  if (section) observer.observe(section);
</script>
