---
import type { Locale } from '../i18n';
import { footer } from '../data/footer';
import { socials } from '../data/socials';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="bg-tg-blue p-6">
  <div class="flex flex-col md:flex-row items-center gap-4">
    <a href="#page-top" class="anchor">
      <img class="w-12 mx-auto" src="/assets/images/logo.svg" alt="logo" />
    </a>

    <div class="flex-1 text-tg-pink text-center md:text-right text-xl">
      {socials.map((social) => (
        <a href={social.url} class="mx-1" target={social.external === false ? '_self' : '_blank'} title={social.name}>
          <span class={social.fontawesome}></span>
        </a>
      ))}
    </div>

    <div class="flex-1 md:order-first text-tg-white text-center md:text-left font-extralight text-xs">
      <span class="block xl:inline-block uppercase tracking-wider">
        &copy; Tifenn Guillas {currentYear}
      </span>
      <span class="hidden xl:inline-block pr-1">|</span>
      <span class="block xl:inline-block pt-2">
        {footer.description[locale]}
        <a
          class="underline hover:text-tg-pink"
          href="https://github.com/tifenn-guillas/tifenn-guillas.github.io"
          target="_blank"
          title="GitHub"
        >
          GitHub
        </a>
      </span>
    </div>
  </div>
</footer>
