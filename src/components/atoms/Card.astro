---
import type { SkillTechnology } from '../../types';

interface Props {
  name: string;
  technologies: SkillTechnology[];
}

const { name, technologies } = Astro.props;
---

<div class="border-2 border-tg-pink">
  <h3 class="p-4 uppercase">{name}</h3>
  <div class="mx-4 h-px bg-tg-pink"></div>
  <div class="my-4">
    {technologies.map((tech) => (
      <div class="flex gap-4 ml-4 my-2 items-center">
        <i class={`${tech.icon} fa-fw fa-lg flex-none`} aria-hidden="true" />
        <span class="text-sm">{tech.label}</span>
      </div>
    ))}
  </div>
</div>
