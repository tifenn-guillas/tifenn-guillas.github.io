---
import type { Locale } from '../../i18n';
import { about } from '../../data/about';
import BlockName from '../atoms/BlockName.astro';

interface Props {
  locale: Locale;
  label: string;
}

const { locale, label } = Astro.props;
---

<div id="about" class="py-16 xl:px-24 2xl:px-52 bg-tg-white">
  <div class="container mx-auto">
    <BlockName label={label} background="white" direction="left" />

    <div class="flex flex-col md:flex-row lg:gap-12 lg:px-20 xl:px-40">
      <div class="flex-none self-center md:order-last p-6">
        <div class="rounded-full border-2 border-tg-pink">
          <div class="w-64 h-64 rounded-full border-4 border-tg-white overflow-hidden">
            <picture>
              <source srcset="/assets/images/profile.webp" type="image/webp" />
              <img src="/assets/images/profile.jpg" alt="Photo de profil de Tifenn Guillas" width="248" height="272" />
            </picture>
          </div>
        </div>
      </div>

      <div class="flex-grow py-12 md:py-0 px-6 text-center md:text-left">
        <h3 class="mb-2.5 text-tg-gray text-xl tracking-normal">
          {about.title[locale]}
        </h3>
        <h5 class="mb-6 italic text-sm font-thin">
          {about.subtitle[locale]}
        </h5>
        <p class="leading-6 text-justify">
          {about.description[locale]}
        </p>
        <div class="mt-12 flex flex-col sm:flex-row justify-around md:justify-start gap-10 text-sm">
          <div>
            <a href="#contact" class="anchor inline-block border-2 border-tg-pink bg-tg-pink text-tg-white uppercase px-6 py-3 text-sm tracking-widest hover:bg-tg-white hover:text-tg-pink">
              {about.contact[locale]}
            </a>
          </div>
          <div>
            <a
              href={about.download_href[locale]}
              target="_blank"
              class="inline-block border-2 border-tg-pink bg-tg-pink text-tg-white uppercase px-6 py-3 text-sm tracking-widest hover:bg-tg-white hover:text-tg-pink"
              title={about.download_description[locale]}
            >
              {about.download[locale]}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
