---
import type { Locale } from '../../i18n';
import { formation } from '../../data/formation';
import BlockName from '../atoms/BlockName.astro';

interface Props {
  locale: Locale;
  label: string;
}

const { locale, label } = Astro.props;
---

<div id="formation" class="py-16 xl:px-24 2xl:px-52 bg-tg-white">
  <div class="container mx-auto">
    <BlockName label={label} background="white" direction="right" />

    <div class="px-6 lg:px-20 xl:px-40">
      <h4 class="mb-4 text-center uppercase">
        {formation.title[locale]}
      </h4>
      <div class="my-12">
        <div class="mt-10 grid grid-cols-1 md:grid-cols-2 md:gap-6">
          {formation.list.map((item) => (
            <>
              <div class="mb-2 md:text-right">
                <div class="inline-block leading-loose md:leading-normal text-tg-pink md:text-tg-gray text-sm md:text-base tracking-widest md:tracking-wider font-light border-b-2 border-tg-pink md:border-0">
                  {item.date}
                </div>
              </div>
              <div class="pb-4 md:pb-0 md:col-start-2">
                <p class="italic">{item.title[locale]}</p>
                {item.note && <p class="font-thin italic">{item.note[locale]}</p>}
                {item.location && <p class="text-tg-pink italic">{item.location[locale]}</p>}
              </div>
            </>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>
