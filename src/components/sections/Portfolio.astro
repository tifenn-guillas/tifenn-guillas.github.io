---
import type { Locale } from '../../i18n';
import { portfolio } from '../../data/portfolio';
import BlockName from '../atoms/BlockName.astro';

interface Props {
  locale: Locale;
  label: string;
}

const { locale, label } = Astro.props;
---

<div id="portfolio" class="py-16 xl:px-24 2xl:px-52 bg-tg-blue">
  <div class="container mx-auto">
    <BlockName label={label} background="blue" direction="left" />

    <div class="px-6 lg:px-20 xl:px-40 grid grid-cols-2 2xl:grid-cols-4 gap-6 sm:gap-12">
      {portfolio.map((project) => (
        <>
          <a class="image-popup flex" href={`#${project.id}`}>
            <img
              class="flex-1 object-fill"
              src={`/assets/images/portfolio/${project.miniature}`}
              alt={`Project ${project.title} thumbnail`}
            />
          </a>

          <div id={project.id} class="container mx-auto my-32 zoom-anim-dialog mfp-hide">
            <div class="bg-tg-blue">
              <div class="flex justify-end">
                <button type="button" class="popup-modal-close p-2.5 text-tg-pink">
                  <span class="fas fa-times fa-lg fa-fw"></span>
                </button>
              </div>
              <div class="px-14">
                <h4 class="text-tg-white">{project.title}</h4>
                <p class="pt-6 text-justify text-tg-soft-gray" set:html={project.description[locale]} />
                {project.hashtags && (
                  <p class="pt-6 text-tg-pink font-thin tracking-wide italic">
                    {project.hashtags.map((tech) => `#${tech}`).join(' ')}
                  </p>
                )}
                {project.images.map((image) => (
                  <img
                    class="py-9"
                    src={`/assets/images/portfolio/${image}`}
                    alt={`Image ${image}`}
                  />
                ))}
              </div>
            </div>
          </div>
        </>
      ))}
    </div>
  </div>
</div>
