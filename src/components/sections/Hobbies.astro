---
import type { Locale } from '../../i18n';
import { hobbies } from '../../data/hobbies';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div class="py-16 bg-tg-blue">
  <div class="container mx-auto px-6">
    <p class="mb-10 text-center text-lg text-tg-soft-gray">
      {hobbies.description[locale]}
    </p>
    <div class="text-center">
      <a
        href={hobbies.download_href[locale]}
        target="_blank"
        class="inline-block p-2.5 border-2 border-tg-pink bg-tg-pink text-tg-white text-sm uppercase tracking-widest hover:bg-tg-white hover:text-tg-pink"
        title={hobbies.download_description[locale]}
      >
        {hobbies.download[locale]}
      </a>
    </div>
  </div>
</div>
